if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "CUDA requires a 64-bit host toolchain")
endif()

bspai_library(bspai_cuda_spmv src/cuda_spmv.cu)
target_link_libraries(bspai_cuda_spmv PUBLIC bspai_cpu CUDA::cudart CUDA::cusparse)
bspai_library(bspai_cuda_gmres src/cuda_gmres.cu)
target_link_libraries(bspai_cuda_gmres PUBLIC bspai_cuda_spmv CUDA::cublas)
bspai_library(bspai_cuda_spai src/cuda_spai.cu)
target_link_libraries(bspai_cuda_spai PUBLIC bspai_cuda_gmres CUDA::cusolver)
bspai_library(bspai_cuda_ir src/cuda_ir.cpp)
target_link_libraries(bspai_cuda_ir PUBLIC bspai_cuda_spai)

bspai_library(bspai_fp32_cuda_spmv src/fp32_cuda_spmv.cu)
target_link_libraries(bspai_fp32_cuda_spmv PUBLIC bspai_fp32_cpu CUDA::cudart CUDA::cusparse)
bspai_library(bspai_fp32_cuda_gmres src/fp32_cuda_gmres.cu)
target_link_libraries(bspai_fp32_cuda_gmres PUBLIC bspai_fp32_cuda_spmv CUDA::cublas)
bspai_library(bspai_fp32_cuda_spai src/fp32_cuda_spai.cu)
target_link_libraries(bspai_fp32_cuda_spai PUBLIC bspai_fp32_cuda_gmres CUDA::cusolver)

bspai_executable(cuda_hybrid_ir src/cuda_hybrid_main.cpp bspai_cuda_ir)
bspai_executable(cuda_gpu_spai_ir src/cuda_hybrid_main.cpp bspai_cuda_ir)
target_compile_definitions(cuda_gpu_spai_ir PRIVATE BSPAI_GPU_CONSTRUCTION=1)
foreach(precision IN ITEMS fp32 fp64)
  if(precision STREQUAL "fp32")
    set(solver_library bspai_fp32_cuda_spai)
  else()
    set(solver_library bspai_cuda_ir)
  endif()
  bspai_executable(gpu_${precision}_ir src/solver_main.cpp ${solver_library})
  target_link_libraries(gpu_${precision}_ir PRIVATE bspai_cpu)
  target_compile_definitions(gpu_${precision}_ir PRIVATE BSPAI_SOLVER_CUDA=1)
endforeach()
target_compile_definitions(gpu_fp32_ir PRIVATE BSPAI_SOLVER_FP32=1)
bspai_executable(cuda_environment_probe src/cuda_environment.cpp bspai_cuda_spai)
bspai_executable(cuda_norm_probe src/cuda_norm_probe.cpp bspai_cuda_gmres)

if(BUILD_TESTING)
  bspai_test(cuda_spmv_tests tests/test_cuda_spmv.cpp bspai_cuda_spmv)
  bspai_test(cuda_gmres_tests tests/test_cuda_gmres.cpp bspai_cuda_gmres)
  bspai_test(cuda_ir_tests tests/test_cuda_ir.cpp bspai_cuda_ir)
  bspai_test(cuda_spai_tests tests/test_cuda_spai.cpp bspai_cuda_ir)
  bspai_test(fp32_cuda_spmv_tests tests/test_fp32_cuda_spmv.cpp bspai_fp32_cuda_spmv)
  bspai_test(fp32_cuda_gmres_tests tests/test_fp32_cuda_gmres.cpp bspai_fp32_cuda_gmres)
  bspai_test(fp32_cuda_spai_tests tests/test_fp32_cuda_spai.cpp bspai_fp32_cuda_spai)

  bspai_library(bspai_cuda_spai_gate3_reference tests/reference/cuda_spai_gate3.cu)
  target_link_libraries(bspai_cuda_spai_gate3_reference PUBLIC bspai_cuda_gmres CUDA::cusolver)
  target_include_directories(bspai_cuda_spai_gate3_reference PUBLIC "${BSPAI_ROOT}/tests/reference")
  bspai_executable(cuda_spai_sparse_tests tests/test_cuda_spai_sparse.cpp bspai_cuda_ir)
  target_sources(cuda_spai_sparse_tests PRIVATE "${BSPAI_ROOT}/tests/cuda_spai_allocation_audit.cu")
  target_link_libraries(cuda_spai_sparse_tests PRIVATE bspai_cuda_spai_gate3_reference)
  add_test(NAME cuda_spai_sparse_tests COMMAND cuda_spai_sparse_tests)
endif()
